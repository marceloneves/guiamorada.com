---
import Layout from '../layouts/Layout.astro';
import { webPageSchema, breadcrumbSchema, CONTATO } from '../lib/schema';

const whatsappLabel = '+55 48 98810-5199';
const whatsappLink = `https://wa.me/5548988105199?text=${encodeURIComponent(
  'Olá! Vim pelo Guia Morada e gostaria de falar com vocês.',
)}`;

const title = 'Contato';
const description =
  'Fale com o Guia Morada por WhatsApp ou e-mail: anúncios, correção de dados de uma empresa listada e dúvidas sobre o diretório.';

const canais = [
  {
    nome: 'WhatsApp',
    valor: whatsappLabel,
    descricao: 'Atendimento em dias úteis, das 9h às 18h.',
    href: whatsappLink,
    externo: true,
  },
  {
    nome: 'E-mail',
    valor: CONTATO.email,
    descricao: 'Respondemos em até dois dias úteis.',
    href: `mailto:${CONTATO.email}`,
    externo: false,
  },
];

const assuntos = [
  {
    titulo: 'Quero anunciar',
    texto: 'Planos para corretores e imobiliárias, com valor fixo por período.',
    acao: { label: 'Ver planos e preços', href: '/anuncie/' },
  },
  {
    titulo: 'Corrigir ou remover os dados da minha empresa',
    texto:
      'As fichas por cidade vêm de registros públicos de empresas. Se algum dado está errado ou você quer que a ficha saia do site, escreva informando o CNPJ e o que precisa ser ajustado.',
    acao: { label: `Escrever para ${CONTATO.email}`, href: `mailto:${CONTATO.email}?subject=${encodeURIComponent('Correção de dados de empresa listada')}` },
  },
  {
    titulo: 'Imprensa e parcerias',
    texto: 'Dados do diretório, propostas de parceria e integrações.',
    acao: { label: 'Falar no WhatsApp', href: whatsappLink },
  },
];

const schema = [
  webPageSchema({ type: 'ContactPage', path: '/contato/', name: title, description }),
  breadcrumbSchema([
    { name: 'Início', path: '/' },
    { name: 'Contato', path: '/contato/' },
  ]),
];
---

<Layout title={title} description={description} schema={schema}>
  <div class="border-b border-stone-200 bg-white">
    <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8">
      <h1 class="font-display text-3xl font-bold text-stone-900 sm:text-4xl">Fale com o Guia Morada</h1>
      <p class="mt-3 leading-relaxed text-muted">
        Dúvida sobre um anúncio, correção de dados de uma empresa listada ou proposta de parceria: escolha o canal que
        for mais prático. Falamos português.
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-4 sm:grid-cols-2">
      {canais.map((canal) => (
        <a
          href={canal.href}
          target={canal.externo ? '_blank' : undefined}
          rel={canal.externo ? 'noopener noreferrer' : undefined}
          class="group rounded-2xl border border-stone-200 bg-white p-6 transition hover:border-brand-300 hover:shadow-md"
        >
          <span class="text-xs font-medium uppercase tracking-wide text-stone-500">{canal.nome}</span>
          <span class="mt-1 block text-lg font-semibold text-stone-900 group-hover:text-brand-700">{canal.valor}</span>
          <span class="mt-2 block text-sm text-muted">{canal.descricao}</span>
        </a>
      ))}
    </div>

    <h2 class="font-display mt-12 text-xl font-semibold text-stone-900">Sobre o que você quer falar?</h2>
    <div class="mt-5 space-y-4">
      {assuntos.map((assunto) => (
        <div class="rounded-2xl border border-stone-200 bg-white p-6">
          <h3 class="font-semibold text-stone-900">{assunto.titulo}</h3>
          <p class="mt-2 leading-relaxed text-muted">{assunto.texto}</p>
          <a href={assunto.acao.href} class="mt-3 inline-flex text-sm font-medium text-brand-700 hover:underline">
            {assunto.acao.label}
          </a>
        </div>
      ))}
    </div>

    <div class="mt-10 rounded-2xl border border-stone-200 bg-stone-50 p-6 text-sm leading-relaxed text-muted">
      <p>
        O Guia Morada é um registro de imobiliárias e corretores por cidade. Não intermediamos negócios, não cobramos
        comissão e não representamos nenhuma das empresas listadas — para tratar de um imóvel, fale direto com a empresa
        na ficha dela.
      </p>
    </div>
  </div>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import { loadCidadesIndex } from '../../lib/load-cidade';
import { getPrepositionLabel } from '../../lib/cidades';

const cidades = loadCidadesIndex();
const topCidades = cidades.slice(0, 12);
const totalImobiliarias = cidades.reduce((s, c) => s + c.total, 0);
---

<Layout
  title="Imobiliárias"
  description="Encontre imobiliárias em mais de 2.400 cidades brasileiras. Telefone e endereço de empresas do setor imobiliário."
>
  <div class="border-b border-stone-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
      <h1 class="font-display text-3xl font-bold text-stone-900 sm:text-4xl">Imobiliárias</h1>
      <p class="mt-2 text-muted">
        {totalImobiliarias.toLocaleString('pt-BR')} imobiliárias em {cidades.length.toLocaleString('pt-BR')} cidades
      </p>
      <a
        href="/imobiliarias/cidades"
        class="mt-6 inline-flex items-center gap-2 rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-700 transition"
      >
        Ver todas as cidades
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <h2 class="font-display text-xl font-semibold text-stone-900">Principais cidades</h2>
    <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {topCidades.map((city) => (
        <a
          href={`/${city.slug}`}
          class="group flex items-center justify-between rounded-2xl border border-stone-200 bg-white p-5 transition hover:border-brand-300 hover:shadow-lg hover:shadow-brand-900/5"
        >
          <div>
            <h3 class="font-semibold text-stone-900 group-hover:text-brand-700">
              Imobiliárias {getPrepositionLabel(city.prep, city.cidade)}
            </h3>
            <p class="mt-1 text-sm text-muted">{city.estado}</p>
          </div>
          <span class="rounded-full bg-brand-50 px-3 py-1 text-sm font-semibold text-brand-800">
            {city.total.toLocaleString('pt-BR')}
          </span>
        </a>
      ))}
    </div>
  </div>
</Layout>

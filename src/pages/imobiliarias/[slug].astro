---
import Layout from '../../layouts/Layout.astro';
import StarRating from '../../components/StarRating.astro';
import Badge from '../../components/Badge.astro';
import CardCorretor from '../../components/CardCorretor.astro';
import { imobiliarias, getImobiliariaBySlug } from '../../data/imobiliarias';
import { getCorretoresByImobiliariaId } from '../../data/corretores';
import { especialidadeLabels } from '../../types/directory';

export function getStaticPaths() {
  return imobiliarias.map((i) => ({ params: { slug: i.slug } }));
}

const { slug } = Astro.params;
const imobiliaria = getImobiliariaBySlug(slug!);

if (!imobiliaria) {
  return Astro.redirect('/imobiliarias');
}

const equipe = getCorretoresByImobiliariaId(imobiliaria.id);
const whatsappLink = `https://wa.me/${imobiliaria.whatsapp}?text=${encodeURIComponent(`Olá! Vi a ${imobiliaria.nome} no Guia Morada e gostaria de mais informações.`)}`;
---

<Layout title={imobiliaria.nome} description={imobiliaria.descricao}>
  <!-- Capa -->
  <div class="relative h-56 sm:h-72 lg:h-80">
    <img
      src={imobiliaria.capa}
      alt={imobiliaria.nome}
      class="h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-stone-900/80 via-stone-900/30 to-transparent"></div>
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="-mt-16 relative z-10 rounded-2xl border border-stone-200 bg-white p-6 shadow-xl sm:p-8">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
        <img
          src={imobiliaria.logo}
          alt={imobiliaria.nome}
          class="h-20 w-20 shrink-0 rounded-2xl border-4 border-white bg-white shadow-lg sm:h-24 sm:w-24"
        />
        <div class="flex-1">
          <div class="flex flex-wrap items-center gap-2">
            <h1 class="font-display text-2xl font-bold text-stone-900 sm:text-3xl">{imobiliaria.nome}</h1>
            {imobiliaria.verificada && <Badge label="Verificada" variant="verified" />}
            {imobiliaria.destaque && <Badge label="Destaque" variant="brand" />}
          </div>
          <p class="mt-1 text-lg text-brand-700 italic">{imobiliaria.slogan}</p>
          <p class="mt-2 text-muted">
            {imobiliaria.endereco.rua && `${imobiliaria.endereco.rua} · `}
            {imobiliaria.endereco.bairro}, {imobiliaria.endereco.cidade} — {imobiliaria.endereco.estado}
          </p>
          <div class="mt-3 flex flex-wrap items-center gap-4">
            <div class="flex items-center gap-2">
              <StarRating rating={imobiliaria.avaliacao} size="md" />
              <span class="font-semibold">{imobiliaria.avaliacao.toFixed(1)}</span>
              <span class="text-sm text-muted">({imobiliaria.totalAvaliacoes} avaliações)</span>
            </div>
            <span class="text-sm text-muted">CRECI {imobiliaria.creci}</span>
            <span class="text-sm text-muted">Desde {imobiliaria.anoFundacao}</span>
          </div>
        </div>

        <div class="flex flex-col gap-2 sm:shrink-0">
          <a
            href={whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-5 py-3 text-sm font-semibold text-white hover:bg-emerald-700 transition"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.881 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp
          </a>
          <a href={`tel:${imobiliaria.telefone.replace(/\D/g, '')}`} class="inline-flex items-center justify-center gap-2 rounded-xl border border-stone-200 px-5 py-3 text-sm font-semibold text-stone-700 hover:bg-stone-50 transition">
            {imobiliaria.telefone}
          </a>
          {imobiliaria.site && (
            <a href={imobiliaria.site} target="_blank" rel="noopener noreferrer" class="text-center text-sm font-medium text-brand-700 hover:underline">
              Visitar site →
            </a>
          )}
        </div>
      </div>
    </div>

    <div class="mt-10 grid gap-10 lg:grid-cols-3">
      <div class="lg:col-span-2 space-y-8">
        <section>
          <h2 class="font-display text-xl font-semibold text-stone-900">Sobre</h2>
          <p class="mt-3 leading-relaxed text-stone-600">{imobiliaria.descricao}</p>
        </section>

        <section>
          <h2 class="font-display text-xl font-semibold text-stone-900">Especialidades</h2>
          <div class="mt-3 flex flex-wrap gap-2">
            {imobiliaria.especialidades.map((esp) => (
              <Badge label={especialidadeLabels[esp]} variant="brand" />
            ))}
          </div>
        </section>

        {equipe.length > 0 && (
          <section>
            <h2 class="font-display text-xl font-semibold text-stone-900">Equipe ({equipe.length})</h2>
            <div class="mt-4 grid gap-4 sm:grid-cols-2">
              {equipe.map((c) => (
                <CardCorretor corretor={c} />
              ))}
            </div>
          </section>
        )}
      </div>

      <aside class="space-y-6">
        <div class="rounded-2xl border border-stone-200 bg-stone-50 p-6">
          <h3 class="font-semibold text-stone-900">Informações</h3>
          <dl class="mt-4 space-y-3 text-sm">
            <div>
              <dt class="text-muted">E-mail</dt>
              <dd class="font-medium text-stone-800">{imobiliaria.email}</dd>
            </div>
            <div>
              <dt class="text-muted">Corretores</dt>
              <dd class="font-medium text-stone-800">{imobiliaria.corretoresCount} profissionais</dd>
            </div>
            <div>
              <dt class="text-muted">Fundação</dt>
              <dd class="font-medium text-stone-800">{imobiliaria.anoFundacao}</dd>
            </div>
          </dl>
        </div>
      </aside>
    </div>
  </div>

  <div class="h-16"></div>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import { loadCidadesIndex } from '../../lib/load-cidade';
import {
  getPrepositionLabel,
  getEstadoNome,
  getRegiao,
  slugifyRegiao,
  REGIOES,
  type CidadeIndexEntry,
  type Regiao,
} from '../../lib/cidades';
import { webPageSchema, breadcrumbSchema, itemListSchema } from '../../lib/schema';

const cidades = loadCidadesIndex();

const totalImobiliarias = cidades.reduce((s, c) => s + c.total, 0);

interface EstadoGroup {
  uf: string;
  nome: string;
  cidades: CidadeIndexEntry[];
  total: number;
}

interface RegiaoGroup {
  regiao: Regiao;
  slug: string;
  estados: EstadoGroup[];
  totalCidades: number;
  total: number;
}

const porEstado = new Map<string, CidadeIndexEntry[]>();
for (const cidade of cidades) {
  const lista = porEstado.get(cidade.estado);
  if (lista) lista.push(cidade);
  else porEstado.set(cidade.estado, [cidade]);
}

const collator = new Intl.Collator('pt-BR');

const regioes: RegiaoGroup[] = REGIOES.map((regiao) => {
  const estados = [...porEstado.entries()]
    .filter(([uf]) => getRegiao(uf) === regiao)
    .map(([uf, lista]) => ({
      uf,
      nome: getEstadoNome(uf),
      cidades: [...lista].sort((a, b) => collator.compare(a.cidade, b.cidade)),
      total: lista.reduce((s, c) => s + c.total, 0),
    }))
    .sort((a, b) => collator.compare(a.nome, b.nome));

  return {
    regiao,
    slug: slugifyRegiao(regiao),
    estados,
    totalCidades: estados.reduce((s, e) => s + e.cidades.length, 0),
    total: estados.reduce((s, e) => s + e.total, 0),
  };
}).filter((r) => r.estados.length > 0);

const tituloPagina = 'Imobiliárias por cidade, estado e região';
const descricaoPagina = `Diretório de imobiliárias em ${cidades.length.toLocaleString('pt-BR')} cidades brasileiras, organizado por região e estado.`;

const schema = [
  webPageSchema({
    type: 'CollectionPage',
    path: '/imobiliarias/cidades/',
    name: tituloPagina,
    description: descricaoPagina,
  }),
  breadcrumbSchema([
    { name: 'Início', path: '/' },
    { name: 'Imobiliárias', path: '/imobiliarias/' },
    { name: 'Cidades', path: '/imobiliarias/cidades/' },
  ]),
  itemListSchema(
    [...cidades]
      .sort((a, b) => b.total - a.total)
      .slice(0, 50)
      .map((c) => ({
        name: `Imobiliárias ${getPrepositionLabel(c.prep, c.cidade)}`,
        path: `/${c.slug}/`,
      })),
    'Cidades com mais imobiliárias',
  ),
];

function normalize(value: string): string {
  return value
    .toLowerCase()
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '');
}
---

<Layout title={tituloPagina} description={descricaoPagina} schema={schema}>
  <div class="border-b border-stone-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
      <h1 class="font-display text-3xl font-bold text-stone-900 sm:text-4xl">Imobiliárias por cidade</h1>
      <p class="mt-2 text-muted">
        {cidades.length.toLocaleString('pt-BR')} cidades · {totalImobiliarias.toLocaleString('pt-BR')} imobiliárias · {regioes.length} regiões
      </p>

      <div class="mt-6 max-w-xl">
        <label for="q" class="mb-1.5 block text-xs font-medium uppercase tracking-wide text-stone-500">
          Buscar cidade ou estado
        </label>
        <input
          type="search"
          id="q"
          autocomplete="off"
          placeholder="Ex: São Paulo, Curitiba, Bahia..."
          class="w-full rounded-xl border border-stone-200 px-4 py-2.5 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20"
        />
        <p id="search-status" class="mt-2 text-sm text-muted" aria-live="polite"></p>
      </div>

      <nav class="mt-6 flex flex-wrap gap-2" aria-label="Regiões">
        {regioes.map((r) => (
          <a
            href={`#${r.slug}`}
            class="rounded-full border border-stone-200 bg-white px-3.5 py-1.5 text-sm font-medium text-stone-700 transition hover:border-brand-300 hover:text-brand-700"
          >
            {r.regiao}
            <span class="ml-1 text-xs text-muted">{r.totalCidades.toLocaleString('pt-BR')}</span>
          </a>
        ))}
      </nav>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <div id="regioes" class="space-y-12">
      {regioes.map((r) => (
        <section id={r.slug} data-regiao class="scroll-mt-24">
          <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-stone-200 pb-3">
            <h2 class="font-display text-2xl font-semibold text-stone-900">{r.regiao}</h2>
            <p class="text-sm text-muted">
              {r.estados.length} {r.estados.length === 1 ? 'estado' : 'estados'} · {r.totalCidades.toLocaleString('pt-BR')} cidades · {r.total.toLocaleString('pt-BR')} imobiliárias
            </p>
          </div>

          <div class="mt-5 space-y-3">
            {r.estados.map((e) => (
              <details id={`uf-${e.uf.toLowerCase()}`} data-estado class="group scroll-mt-24 rounded-2xl border border-stone-200 bg-white">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-5 py-4">
                  <span class="flex items-center gap-3">
                    <span class="rounded-lg bg-brand-50 px-2 py-1 text-xs font-bold text-brand-800">{e.uf}</span>
                    <span class="font-semibold text-stone-900 group-open:text-brand-700">{e.nome}</span>
                  </span>
                  <span class="flex items-center gap-3 text-sm text-muted">
                    <span data-estado-contagem>{e.cidades.length.toLocaleString('pt-BR')} cidades</span>
                    <span class="hidden sm:inline">·</span>
                    <span class="hidden sm:inline">{e.total.toLocaleString('pt-BR')} imobiliárias</span>
                    <svg class="h-4 w-4 shrink-0 transition group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </span>
                </summary>

                <div class="grid gap-2 border-t border-stone-100 px-5 py-4 sm:grid-cols-2 lg:grid-cols-3">
                  {e.cidades.map((city) => (
                    <a
                      href={`/${city.slug}/`}
                      data-cidade
                      data-busca={`${normalize(city.cidade)} ${normalize(e.nome)} ${e.uf.toLowerCase()}`}
                      class="group/city flex items-center justify-between gap-3 rounded-xl border border-stone-200 px-4 py-3 transition hover:border-brand-300 hover:shadow-md"
                    >
                      <span class="text-base font-medium text-stone-900 group-hover/city:text-brand-700">
                        Imobiliárias {getPrepositionLabel(city.prep, city.cidade)}
                      </span>
                      <span class="rounded-full bg-brand-50 px-2.5 py-1 text-sm font-semibold text-brand-800">
                        {city.total.toLocaleString('pt-BR')}
                      </span>
                    </a>
                  ))}
                </div>
              </details>
            ))}
          </div>
        </section>
      ))}
    </div>

    <p id="sem-resultados" hidden class="py-16 text-center text-muted">
      Nenhuma cidade encontrada para esta busca.
    </p>
  </div>
</Layout>

<script>
  const input = document.getElementById('q') as HTMLInputElement | null;
  const status = document.getElementById('search-status');
  const vazio = document.getElementById('sem-resultados');
  if (input) {
    const estados = [...document.querySelectorAll<HTMLDetailsElement>('[data-estado]')].map((el) => ({
      el,
      contagem: el.querySelector('[data-estado-contagem]'),
      total: el.querySelectorAll('[data-cidade]').length,
      cidades: [...el.querySelectorAll<HTMLAnchorElement>('[data-cidade]')].map((a) => ({
        el: a,
        busca: a.dataset.busca ?? '',
      })),
    }));
    const regioes = [...document.querySelectorAll<HTMLElement>('[data-regiao]')];

    const plural = (n: number) => `${n.toLocaleString('pt-BR')} ${n === 1 ? 'cidade' : 'cidades'}`;

    function filtrar(termo: string) {
      const q = termo
        .trim()
        .toLowerCase()
        .normalize('NFD')
        .replace(/[̀-ͯ]/g, '');
      let encontradas = 0;

      for (const estado of estados) {
        let visiveis = 0;
        for (const cidade of estado.cidades) {
          const match = !q || cidade.busca.includes(q);
          cidade.el.hidden = !match;
          if (match) visiveis++;
        }
        encontradas += visiveis;
        estado.el.hidden = visiveis === 0;
        estado.el.open = q.length > 0 && visiveis > 0;
        if (estado.contagem) estado.contagem.textContent = plural(q ? visiveis : estado.total);
      }

      for (const regiao of regioes) {
        regiao.hidden = ![...regiao.querySelectorAll<HTMLDetailsElement>('[data-estado]')].some((e) => !e.hidden);
      }

      if (status) status.textContent = q ? `${plural(encontradas)} encontradas` : '';
      if (vazio) vazio.hidden = encontradas > 0;
    }

    let timer: ReturnType<typeof setTimeout>;
    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(() => filtrar(input.value), 120);
    });
    if (input.value) filtrar(input.value);
  }
</script>

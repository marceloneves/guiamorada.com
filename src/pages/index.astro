---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import StatsBar from '../components/StatsBar.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CardCorretor from '../components/CardCorretor.astro';
import { loadCidadesIndex } from '../lib/load-cidade';
import { loadConstrutorasIndex } from '../lib/load-construtoras';
import { getPrepositionLabel, getCapitais } from '../lib/cidades';
import { corretores } from '../data/corretores';
import { webPageSchema, itemListSchema, corretorSchema } from '../lib/schema';

const cidadesIndex = loadCidadesIndex();
const totalImobiliarias = cidadesIndex.reduce((s, c) => s + c.total, 0);
const capitais = getCapitais(cidadesIndex);
const construtorasIndex = loadConstrutorasIndex();
const totalConstrutoras = construtorasIndex.reduce((s, c) => s + c.total, 0);
const destaquesCorret = corretores.filter((c) => c.destaque).slice(0, 4);

const schema = [
  webPageSchema({
    path: '/',
    name: 'Guia Morada — Diretório de Imobiliárias, Construtoras e Corretores',
    description:
      'Registro de imobiliárias, construtoras e corretores de imóveis em cada cidade do Brasil. Busque por cidade ou nome.',
  }),
  itemListSchema(
    capitais.map((c) => ({
      name: `Imobiliárias ${getPrepositionLabel(c.prep, c.cidade)}`,
      path: `/${c.slug}/`,
    })),
    'Imobiliárias nas capitais',
  ),
  ...(construtorasIndex.length
    ? [
        itemListSchema(
          construtorasIndex.map((c) => ({
            name: `Construtoras ${getPrepositionLabel(c.prep, c.cidade)}`,
            path: `/${c.slug}/`,
          })),
          'Construtoras e incorporadoras por cidade',
        ),
      ]
    : []),
  itemListSchema(
    destaquesCorret.map((c) => ({ name: c.nome, path: `/corretores/${c.slug}/` })),
    'Corretores cadastrados',
  ),
];
---

<Layout schema={schema}>
  <Hero
    topCidades={cidadesIndex.slice(0, 4)}
    totalImobiliarias={totalImobiliarias}
    totalConstrutoras={totalConstrutoras}
  />
  <StatsBar />

  <!-- Principais cidades -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <SectionHeading
      title="Imobiliárias por cidade"
      subtitle="As 27 capitais brasileiras. Veja o diretório completo para as demais cidades."
      action={{ href: '/imobiliarias/cidades/', label: 'Ver todas as cidades' }}
    />
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {capitais.map((city) => (
        <a
          href={`/${city.slug}/`}
          class="group flex items-center justify-between rounded-2xl border border-stone-200 bg-white p-5 transition hover:border-brand-300 hover:shadow-lg hover:shadow-brand-900/5"
        >
          <div>
            <h3 class="font-semibold text-stone-900 group-hover:text-brand-700">
              Imobiliárias {getPrepositionLabel(city.prep, city.cidade)}
            </h3>
            <p class="mt-1 text-sm text-muted">{city.estado}</p>
          </div>
          <span class="rounded-full bg-brand-50 px-3 py-1 text-sm font-semibold text-brand-800">
            {city.total.toLocaleString('pt-BR')}
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Construtoras e incorporadoras -->
  {construtorasIndex.length > 0 && (
    <section class="mx-auto max-w-7xl px-4 pb-4 sm:px-6 lg:px-8">
      <SectionHeading
        title="Construtoras e incorporadoras"
        subtitle="Quem constrói e incorpora na cidade, direto do cadastro público de CNPJ da Receita Federal."
        action={{ href: '/construtoras/', label: 'Ver todas' }}
      />
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {construtorasIndex.map((cidade) => (
          <a
            href={`/${cidade.slug}/`}
            class="group flex items-center justify-between rounded-2xl border border-stone-200 bg-white p-5 transition hover:border-brand-300 hover:shadow-lg hover:shadow-brand-900/5"
          >
            <div>
              <h3 class="font-semibold text-stone-900 group-hover:text-brand-700">
                Construtoras {getPrepositionLabel(cidade.prep, cidade.cidade)}
              </h3>
              <p class="mt-1 text-sm text-muted">{cidade.estado}</p>
            </div>
            <span class="rounded-full bg-brand-50 px-3 py-1 text-sm font-semibold text-brand-800">
              {cidade.total.toLocaleString('pt-BR')}
            </span>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Corretores em destaque -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <SectionHeading
      title="Corretores cadastrados"
      subtitle="Profissionais com registro no diretório, por cidade."
      action={{ href: '/corretores/', label: 'Ver todos' }}
    />
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {destaquesCorret.map((corretor) => (
        <CardCorretor corretor={corretor} />
      ))}
    </div>
  </section>

  <!-- CTA Anuncie -->
  <section class="mx-auto max-w-7xl px-4 pb-20 sm:px-6 lg:px-8">
    <div class="relative overflow-hidden rounded-3xl bg-brand-800 px-6 py-14 text-center sm:px-12">
      <div class="absolute inset-0 opacity-20">
        <div class="absolute -right-10 -top-10 h-64 w-64 rounded-full bg-brand-400 blur-3xl"></div>
        <div class="absolute -bottom-10 -left-10 h-64 w-64 rounded-full bg-teal-400 blur-3xl"></div>
      </div>
      <div class="relative">
        <h2 class="font-display text-3xl font-bold text-white sm:text-4xl">
          Faça parte do Guia Morada
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-brand-100">
          Registre sua imobiliária ou seu perfil de corretor na cidade em que você atua. Preço fixo por período, sem comissão por contato.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a
            href="/anuncie/"
            class="inline-flex w-full items-center justify-center rounded-xl bg-white px-6 py-3 text-sm font-semibold text-brand-800 transition hover:bg-brand-50 sm:w-auto"
          >
            Ver planos e preços
          </a>
          <a
            href="https://wa.me/5548988105199?text=Ol%C3%A1!%20Quero%20anunciar%20no%20Guia%20Morada."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex w-full items-center justify-center rounded-xl border border-white/30 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/10 sm:w-auto"
          >
            Falar no WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

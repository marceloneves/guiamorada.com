---
import Layout from '../layouts/Layout.astro';

const tipo = Astro.url.searchParams.get('tipo') ?? 'imobiliaria';
const isImobiliaria = tipo === 'imobiliaria';
---

<Layout
  title="Cadastre-se"
  description="Cadastre sua imobiliária ou perfil de corretor gratuitamente no Guia Morada."
>
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="text-center">
      <h1 class="font-display text-3xl font-bold text-stone-900 sm:text-4xl">Cadastre-se no Guia Morada</h1>
      <p class="mt-3 text-muted">
        Amplie sua visibilidade e conecte-se com clientes em todo o Brasil. O cadastro é gratuito.
      </p>
    </div>

    <!-- Tabs -->
    <div class="mt-8 flex rounded-xl border border-stone-200 bg-stone-100 p-1">
      <a
        href="/cadastro?tipo=imobiliaria"
        class:list={[
          'flex-1 rounded-lg py-2.5 text-center text-sm font-semibold transition',
          isImobiliaria ? 'bg-white text-brand-800 shadow-sm' : 'text-stone-600 hover:text-stone-900',
        ]}
      >
        Imobiliária
      </a>
      <a
        href="/cadastro?tipo=corretor"
        class:list={[
          'flex-1 rounded-lg py-2.5 text-center text-sm font-semibold transition',
          !isImobiliaria ? 'bg-white text-brand-800 shadow-sm' : 'text-stone-600 hover:text-stone-900',
        ]}
      >
        Corretor
      </a>
    </div>

    <form class="mt-8 space-y-6 rounded-2xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
      <div class="grid gap-5 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <label for="nome" class="mb-1.5 block text-sm font-medium text-stone-700">
            {isImobiliaria ? 'Nome da imobiliária' : 'Nome completo'}
          </label>
          <input
            type="text"
            id="nome"
            name="nome"
            required
            placeholder={isImobiliaria ? 'Ex: Morada Prime Imóveis' : 'Ex: Ana Paula Mendes'}
            class="w-full rounded-xl border border-stone-200 px-4 py-2.5 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20"
          />
        </div>

        <div>
          <label for="email" class="mb-1.5 block text-sm font-medium text-stone-700">E-mail</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder="contato@email.com"
            class="w-full rounded-xl border border-stone-200 px-4 py-2.5 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20"
          />
        </div>

        <div>
          <label for="telefone" class="mb-1.5 block text-sm font-medium text-stone-700">Telefone / WhatsApp</label>
          <input
            type="tel"
            id="telefone"
            name="telefone"
            required
            placeholder="(11) 99999-9999"
            class="w-full rounded-xl border border-stone-200 px-4 py-2.5 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20"
          />
        </div>

        <div>
          <label for="creci" class="mb-1.5 block text-sm font-medium text-stone-700">CRECI</label>
          <input
            type="text"
            id="creci"
            name="creci"
            required
            placeholder={isImobiliaria ? 'J-12345' : '123456-F'}
            class="w-full rounded-xl border border-stone-200 px-4 py-2.5 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20"
          />
        </div>

        <div>
          <label for="cidade" class="mb-1.5 block text-sm font-medium text-stone-700">Cidade</label>
          <input
            type="text"
            id="cidade"
            name="cidade"
            required
            placeholder="São Paulo"
            class="w-full rounded-xl border border-stone-200 px-4 py-2.5 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20"
          />
        </div>

        <div class="sm:col-span-2">
          <label for="descricao" class="mb-1.5 block text-sm font-medium text-stone-700">
            {isImobiliaria ? 'Descrição da empresa' : 'Sobre você'}
          </label>
          <textarea
            id="descricao"
            name="descricao"
            rows="4"
            placeholder="Conte um pouco sobre sua experiência e especialidades..."
            class="w-full rounded-xl border border-stone-200 px-4 py-2.5 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20"
          ></textarea>
        </div>
      </div>

      <label class="flex items-start gap-3 text-sm text-stone-600">
        <input type="checkbox" required class="mt-1 rounded border-stone-300 text-brand-600 focus:ring-brand-500" />
        <span>
          Concordo com os termos de uso e autorizo a publicação dos dados informados no Guia Morada.
        </span>
      </label>

      <button
        type="submit"
        class="w-full rounded-xl bg-brand-600 py-3.5 text-sm font-semibold text-white transition hover:bg-brand-700"
      >
        Enviar cadastro
      </button>

      <p class="text-center text-xs text-muted">
        Formulário demonstrativo. A integração com backend será configurada em uma próxima etapa.
      </p>
    </form>
  </div>
</Layout>

<script>
  document.querySelector('form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    alert('Cadastro recebido! Em breve entraremos em contato para confirmar seus dados.');
  });
</script>

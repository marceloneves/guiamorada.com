---
import Layout from '../../layouts/Layout.astro';
import StarRating from '../../components/StarRating.astro';
import Badge from '../../components/Badge.astro';
import { corretores, getCorretorBySlug } from '../../data/corretores';
import { getImobiliariaById } from '../../data/imobiliarias';
import { especialidadeLabels } from '../../types/directory';

export function getStaticPaths() {
  return corretores.map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const corretor = getCorretorBySlug(slug!);

if (!corretor) {
  return Astro.redirect('/corretores');
}

const imobiliaria = corretor.imobiliariaId ? getImobiliariaById(corretor.imobiliariaId) : undefined;

const whatsappLink = `https://wa.me/${corretor.whatsapp}?text=${encodeURIComponent(`Olá ${corretor.nome}! Vi seu perfil no Guia Morada e gostaria de conversar sobre imóveis.`)}`;
---

<Layout title={corretor.nome} description={corretor.bio}>
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
        <img
          src={corretor.foto}
          alt={corretor.nome}
          class="h-28 w-28 shrink-0 rounded-2xl border-4 border-brand-50 bg-brand-50 object-cover shadow-lg"
        />

        <div class="flex-1">
          <div class="flex flex-wrap items-center gap-2">
            <h1 class="font-display text-2xl font-bold text-stone-900 sm:text-3xl">{corretor.nome}</h1>
            {corretor.verificado && <Badge label="Verificado" variant="verified" />}
          </div>

          {corretor.imobiliariaNome ? (
            <p class="mt-1">
              <a href={imobiliaria ? `/imobiliarias/${imobiliaria.slug}` : '#'} class="text-brand-700 font-medium hover:underline">
                {corretor.imobiliariaNome}
              </a>
            </p>
          ) : (
            <p class="mt-1 text-muted">Corretor autônomo</p>
          )}

          <p class="mt-2 text-muted">
            {corretor.endereco.bairro}, {corretor.endereco.cidade} — {corretor.endereco.estado}
          </p>

          <div class="mt-3 flex flex-wrap items-center gap-4">
            <div class="flex items-center gap-2">
              <StarRating rating={corretor.avaliacao} size="md" />
              <span class="font-semibold">{corretor.avaliacao.toFixed(1)}</span>
              <span class="text-sm text-muted">({corretor.totalAvaliacoes} avaliações)</span>
            </div>
            <span class="text-sm text-muted">CRECI {corretor.creci}</span>
            <span class="text-sm text-muted">{corretor.anosExperiencia} anos de experiência</span>
          </div>
        </div>

        <div class="flex flex-col gap-2 sm:shrink-0">
          <a
            href={whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-5 py-3 text-sm font-semibold text-white hover:bg-emerald-700 transition"
          >
            WhatsApp
          </a>
          <a href={`tel:${corretor.telefone.replace(/\D/g, '')}`} class="inline-flex items-center justify-center rounded-xl border border-stone-200 px-5 py-3 text-sm font-semibold text-stone-700 hover:bg-stone-50">
            {corretor.telefone}
          </a>
          <a href={`mailto:${corretor.email}`} class="text-center text-sm font-medium text-brand-700 hover:underline">
            {corretor.email}
          </a>
        </div>
      </div>
    </div>

    <div class="mt-10 grid gap-10 lg:grid-cols-3">
      <div class="lg:col-span-2 space-y-8">
        <section>
          <h2 class="font-display text-xl font-semibold text-stone-900">Sobre</h2>
          <p class="mt-3 leading-relaxed text-stone-600">{corretor.bio}</p>
        </section>

        <section>
          <h2 class="font-display text-xl font-semibold text-stone-900">Especialidades</h2>
          <div class="mt-3 flex flex-wrap gap-2">
            {corretor.especialidades.map((esp) => (
              <Badge label={especialidadeLabels[esp]} variant="brand" />
            ))}
          </div>
        </section>
      </div>

      <aside>
        <div class="rounded-2xl border border-stone-200 bg-stone-50 p-6">
          <h3 class="font-semibold text-stone-900">Contato rápido</h3>
          <p class="mt-2 text-sm text-muted">
            Entre em contato diretamente com {corretor.nome.split(' ')[0]} para tirar dúvidas ou agendar uma visita.
          </p>
          <a
            href={whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 flex w-full items-center justify-center rounded-xl bg-brand-600 py-3 text-sm font-semibold text-white hover:bg-brand-700"
          >
            Iniciar conversa
          </a>
        </div>
      </aside>
    </div>
  </div>
</Layout>

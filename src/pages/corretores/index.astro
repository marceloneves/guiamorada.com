---
import Layout from '../../layouts/Layout.astro';
import CardCorretor from '../../components/CardCorretor.astro';
import { corretores, getCidadesCorretores } from '../../data/corretores';
import { especialidadeLabels, type Especialidade } from '../../types/directory';

const q = Astro.url.searchParams.get('q')?.toLowerCase() ?? '';
const cidade = Astro.url.searchParams.get('cidade') ?? '';
const esp = Astro.url.searchParams.get('esp') as Especialidade | null;

const filtered = corretores.filter((c) => {
  const matchQ =
    !q ||
    c.nome.toLowerCase().includes(q) ||
    c.endereco.cidade.toLowerCase().includes(q) ||
    (c.imobiliariaNome?.toLowerCase().includes(q) ?? false);
  const matchCidade = !cidade || c.endereco.cidade === cidade;
  const matchEsp = !esp || c.especialidades.includes(esp);
  return matchQ && matchCidade && matchEsp;
});

const cidades = getCidadesCorretores();
const especialidades = Object.entries(especialidadeLabels) as [Especialidade, string][];
---

<Layout
  title="Corretores"
  description="Encontre corretores de imóveis verificados em todo o Brasil no Guia Morada."
>
  <div class="border-b border-stone-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
      <h1 class="font-display text-3xl font-bold text-stone-900 sm:text-4xl">Corretores</h1>
      <p class="mt-2 text-muted">
        {filtered.length} {filtered.length === 1 ? 'corretor encontrado' : 'corretores encontrados'}
      </p>

      <form method="get" class="mt-6 flex flex-col gap-3 rounded-2xl border border-stone-200 bg-stone-50 p-4 sm:flex-row sm:items-end">
        <div class="flex-1">
          <label for="q" class="mb-1.5 block text-xs font-medium uppercase tracking-wide text-stone-500">Buscar</label>
          <input
            type="search"
            id="q"
            name="q"
            value={q}
            placeholder="Nome ou imobiliária..."
            class="w-full rounded-xl border border-stone-200 bg-white px-4 py-2.5 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20"
          />
        </div>
        <div class="sm:w-48">
          <label for="cidade" class="mb-1.5 block text-xs font-medium uppercase tracking-wide text-stone-500">Cidade</label>
          <select id="cidade" name="cidade" class="w-full rounded-xl border border-stone-200 bg-white px-4 py-2.5 text-sm focus:outline-none">
            <option value="">Todas</option>
            {cidades.map((c) => (
              <option value={c} selected={cidade === c}>{c}</option>
            ))}
          </select>
        </div>
        <div class="sm:w-48">
          <label for="esp" class="mb-1.5 block text-xs font-medium uppercase tracking-wide text-stone-500">Especialidade</label>
          <select id="esp" name="esp" class="w-full rounded-xl border border-stone-200 bg-white px-4 py-2.5 text-sm focus:outline-none">
            <option value="">Todas</option>
            {especialidades.map(([key, label]) => (
              <option value={key} selected={esp === key}>{label}</option>
            ))}
          </select>
        </div>
        <button type="submit" class="rounded-xl bg-brand-600 px-6 py-2.5 text-sm font-semibold text-white hover:bg-brand-700 transition">
          Filtrar
        </button>
      </form>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    {filtered.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {filtered.map((corretor) => (
          <CardCorretor corretor={corretor} />
        ))}
      </div>
    ) : (
      <div class="rounded-2xl border border-dashed border-stone-300 bg-stone-50 py-16 text-center">
        <p class="text-lg font-medium text-stone-700">Nenhum corretor encontrado</p>
        <p class="mt-2 text-muted">Tente ajustar os filtros ou cadastre seu perfil.</p>
        <a href="/cadastro?tipo=corretor" class="mt-6 inline-flex rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-700">
          Cadastrar como corretor
        </a>
      </div>
    )}
  </div>
</Layout>

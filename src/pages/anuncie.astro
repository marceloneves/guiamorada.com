---
import Layout from '../layouts/Layout.astro';
import { webPageSchema, breadcrumbSchema, faqSchema, planoServiceSchema } from '../lib/schema';

const planos = [
  {
    id: 'corretor',
    nome: 'Corretor',
    descricao: 'Para corretores autônomos que querem aparecer no diretório da sua cidade.',
    semestral: 197,
    anual: 347,
    recursos: [
      'Perfil completo com foto, CRECI e bio',
      'Telefone, WhatsApp e e-mail visíveis',
      'Listagem na página de corretores da sua cidade',
      'Link para sua imobiliária ou site',
      'Página própria indexada no Google',
    ],
  },
  {
    id: 'imobiliaria',
    nome: 'Imobiliária',
    descricao: 'Para imobiliárias que querem destaque na cidade e vínculo com sua equipe.',
    semestral: 297,
    anual: 457,
    recursos: [
      'Tudo do plano Corretor',
      'Página da imobiliária com endereço e área de atuação',
      'Corretores da equipe vinculados ao perfil',
      'Destaque na listagem da sua cidade',
      'Atualização de dados sempre que precisar',
    ],
  },
];

const brl = (valor: number) =>
  valor.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL', minimumFractionDigits: 0 });

const brlMes = (valor: number, meses: number) =>
  (valor / meses).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });

const emailContato = 'contato@guiamorada.com';
const whatsapp = '5548988105199';
const whatsappLabel = '+55 48 98810-5199';

const whatsappLink = (plano: string) =>
  `https://wa.me/${whatsapp}?text=${encodeURIComponent(
    `Olá! Quero anunciar no Guia Morada — plano ${plano}.`,
  )}`;

const faq = [
  {
    p: 'O que acontece quando o plano vence?',
    r: 'O perfil deixa de ser exibido até a renovação. Avisamos por e-mail antes do vencimento e os dados ficam guardados.',
  },
  {
    p: 'Preciso ter CRECI ativo?',
    r: 'Sim. Conferimos o número do CRECI antes de publicar o perfil, tanto para corretores quanto para imobiliárias.',
  },
  {
    p: 'Posso mudar de plano depois?',
    r: 'Pode. O valor já pago é abatido proporcionalmente na troca para o plano Imobiliária ou na mudança para o anual.',
  },
  {
    p: 'O Guia Morada indica profissionais?',
    r: 'Não. O site é um registro de imobiliárias e corretores por cidade — não fazemos recomendação nem ranking pago.',
  },
];

const tituloPagina = 'Anuncie aqui — planos e preços';
const descricaoPagina =
  'Planos para corretores e imobiliárias aparecerem no Guia Morada. Corretor a partir de R$ 197 por semestre e imobiliária a partir de R$ 297.';

const schema = [
  webPageSchema({ path: '/anuncie/', name: tituloPagina, description: descricaoPagina }),
  breadcrumbSchema([
    { name: 'Início', path: '/' },
    { name: 'Anuncie aqui', path: '/anuncie/' },
  ]),
  ...planos.map((plano) => planoServiceSchema(plano)),
  faqSchema(faq),
];
---

<Layout
  schema={schema}
  title="Anuncie aqui — planos e preços"
  description="Planos para corretores e imobiliárias aparecerem no Guia Morada. Corretor a partir de R$ 197 por semestre e imobiliária a partir de R$ 297."
>
  <div class="border-b border-stone-200 bg-white">
    <div class="mx-auto max-w-3xl px-4 py-12 text-center sm:px-6 lg:px-8">
      <h1 class="font-display text-3xl font-bold text-stone-900 sm:text-4xl">Anuncie no Guia Morada</h1>
      <p class="mt-3 text-muted">
        Registre sua imobiliária ou seu perfil de corretor na cidade em que você atua. Sem comissão por contato,
        sem leilão de posição — um valor fixo por período.
      </p>

      <div class="mt-8 inline-flex rounded-xl border border-stone-200 bg-stone-100 p-1" role="group" aria-label="Período de cobrança">
        <button
          type="button"
          data-periodo="semestral"
          class="rounded-lg px-5 py-2 text-sm font-semibold text-stone-600 transition"
        >
          Semestral
        </button>
        <button
          type="button"
          data-periodo="anual"
          class="rounded-lg bg-white px-5 py-2 text-sm font-semibold text-brand-800 shadow-sm transition"
          aria-pressed="true"
        >
          Anual
          <span class="ml-1 rounded-full bg-brand-50 px-2 py-0.5 text-xs font-bold text-brand-700">economize</span>
        </button>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-6 md:grid-cols-2">
      {planos.map((plano) => {
        const economia = plano.semestral * 2 - plano.anual;
        return (
          <div class="flex flex-col rounded-2xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
            <h2 class="font-display text-xl font-semibold text-stone-900">{plano.nome}</h2>
            <p class="mt-2 text-sm leading-relaxed text-muted">{plano.descricao}</p>

            <div class="mt-6 border-y border-stone-100 py-6">
              <div data-preco={plano.id} data-mostrar="anual">
                <div class="flex items-baseline gap-2">
                  <span class="font-display text-4xl font-bold text-stone-900" data-valor>{brl(plano.anual)}</span>
                  <span class="text-sm text-muted" data-periodo-label>por ano</span>
                </div>
                <p class="mt-2 text-sm text-muted">
                  <span data-mensal>{brlMes(plano.anual, 12)}</span> por mês
                  <span data-economia class="ml-1 font-medium text-brand-700">· economize {brl(economia)} vs. 2 semestres</span>
                </p>
                <p class="mt-1 text-xs text-stone-400">
                  Semestral: {brl(plano.semestral)} · Anual: {brl(plano.anual)}
                </p>
              </div>
            </div>

            <ul class="mt-6 space-y-3 text-sm text-stone-700">
              {plano.recursos.map((recurso) => (
                <li class="flex items-start gap-2.5">
                  <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{recurso}</span>
                </li>
              ))}
            </ul>

            <a
              href={whatsappLink(plano.nome)}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-8 inline-flex items-center justify-center gap-2 rounded-xl bg-brand-600 px-6 py-3 text-sm font-semibold text-white transition hover:bg-brand-700"
            >
              <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.03-.53-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.38-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35Z" />
                <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.33 4.97L2 22l5.25-1.38a9.86 9.86 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.02h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.18 8.18 0 0 1-1.26-4.36c0-4.53 3.7-8.22 8.24-8.22 2.2 0 4.26.86 5.82 2.41a8.16 8.16 0 0 1 2.41 5.82c0 4.54-3.69 8.21-8.24 8.21Z" />
              </svg>
              Quero anunciar
            </a>
          </div>
        );
      })}
    </div>

    <div class="mt-10 rounded-2xl border border-stone-200 bg-stone-50 p-6 text-sm text-muted sm:p-8">
      <h2 class="font-display text-lg font-semibold text-stone-900">Perguntas frequentes</h2>
      <dl class="mt-5 grid gap-5 sm:grid-cols-2">
        {faq.map((item) => (
          <div>
            <dt class="font-medium text-stone-800">{item.p}</dt>
            <dd class="mt-1 leading-relaxed">{item.r}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-6 border-t border-stone-200 pt-5">
        Dúvidas ou pagamento por outro meio? Chame no WhatsApp
        <a href={whatsappLink('Guia Morada')} target="_blank" rel="noopener noreferrer" class="font-medium text-brand-700 hover:underline">{whatsappLabel}</a>
        ou escreva para
        <a href={`mailto:${emailContato}`} class="font-medium text-brand-700 hover:underline">{emailContato}</a>.
      </p>
    </div>
  </div>
</Layout>

<script>
  const botoes = document.querySelectorAll<HTMLButtonElement>('[data-periodo]');
  const blocos = document.querySelectorAll<HTMLElement>('[data-preco]');

  const precos: Record<string, { semestral: number; anual: number }> = {
    corretor: { semestral: 197, anual: 347 },
    imobiliaria: { semestral: 297, anual: 457 },
  };

  const brl = (valor: number, casas = 0) =>
    valor.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL', minimumFractionDigits: casas });

  function aplicar(periodo: 'semestral' | 'anual') {
    for (const botao of botoes) {
      const ativo = botao.dataset.periodo === periodo;
      botao.setAttribute('aria-pressed', String(ativo));
      botao.classList.toggle('bg-white', ativo);
      botao.classList.toggle('shadow-sm', ativo);
      botao.classList.toggle('text-brand-800', ativo);
      botao.classList.toggle('text-stone-600', !ativo);
    }

    for (const bloco of blocos) {
      const plano = precos[bloco.dataset.preco ?? ''];
      if (!plano) continue;
      const meses = periodo === 'anual' ? 12 : 6;
      const valor = plano[periodo];
      bloco.dataset.mostrar = periodo;
      bloco.querySelector('[data-valor]')!.textContent = brl(valor);
      bloco.querySelector('[data-periodo-label]')!.textContent = periodo === 'anual' ? 'por ano' : 'por semestre';
      bloco.querySelector('[data-mensal]')!.textContent = brl(valor / meses, 2);
      const economia = bloco.querySelector<HTMLElement>('[data-economia]');
      if (economia) economia.hidden = periodo !== 'anual';
    }
  }

  for (const botao of botoes) {
    botao.addEventListener('click', () => aplicar(botao.dataset.periodo as 'semestral' | 'anual'));
  }
</script>

---
import type { ImobiliariaCadastro } from '../lib/cidades';
import { getWhatsAppLink } from '../lib/cidades';
import Badge from './Badge.astro';

interface Props {
  imobiliaria: ImobiliariaCadastro;
}

const { imobiliaria } = Astro.props;
// Parte dos cadastros vem com nome fantasia vazio ou só pontuação; nesses casos vale a razão social.
const fantasia = (imobiliaria.nomeComercial || imobiliaria.nome || '').trim();
const nome = /[a-z0-9]/i.test(fantasia) ? fantasia : imobiliaria.razaoSocial;
const whatsapp = getWhatsAppLink(imobiliaria.telefone, nome);

const endereco = imobiliaria.endereco;
const cidadeUf = [endereco.cidade, endereco.estado].filter(Boolean).join(' - ');
const enderecoCompleto = [
  endereco.completo,
  cidadeUf,
  endereco.cep ? `CEP ${endereco.cep}` : '',
]
  .filter(Boolean)
  .join(' · ');

const initials = nome
  .split(' ')
  .slice(0, 2)
  .map((w) => w[0])
  .join('')
  .toUpperCase();
---

<article class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm transition hover:border-brand-200 hover:shadow-md">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
    <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-brand-100 text-lg font-semibold text-brand-800">
      {initials}
    </div>

    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 class="text-xl font-semibold text-stone-900">{nome}</h2>
          {imobiliaria.razaoSocial && imobiliaria.razaoSocial !== nome && (
            <p class="mt-0.5 text-base text-muted">{imobiliaria.razaoSocial}</p>
          )}
        </div>
      </div>

      {enderecoCompleto && (
        <p class="mt-2 text-base leading-relaxed text-stone-600">{enderecoCompleto}</p>
      )}

      {imobiliaria.areaAtuacao && (
        <p class="mt-2 text-base text-muted">{imobiliaria.areaAtuacao}</p>
      )}

      <div class="mt-3 flex flex-wrap gap-2">
        {imobiliaria.porte && <Badge label={imobiliaria.porte} />}
        {imobiliaria.dataAbertura && (
          <Badge label={`Desde ${imobiliaria.dataAbertura.split('/').pop()}`} variant="brand" />
        )}
      </div>

      <div class="mt-4 flex flex-wrap items-center gap-3 border-t border-stone-100 pt-4">
        {imobiliaria.telefone && (
          <a
            href={`tel:${imobiliaria.telefone.replace(/\D/g, '')}`}
            class="inline-flex items-center gap-1.5 text-base font-medium text-stone-700 hover:text-brand-700"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            {imobiliaria.telefone}
          </a>
        )}
        {whatsapp && (
          <a
            href={whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-3.5 py-2 text-base font-semibold text-white hover:bg-emerald-700"
          >
            WhatsApp
          </a>
        )}
      </div>
    </div>
  </div>
</article>

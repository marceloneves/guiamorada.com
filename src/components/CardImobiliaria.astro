---
import type { Imobiliaria } from '../types/directory';
import { especialidadeLabels } from '../types/directory';
import StarRating from './StarRating.astro';
import Badge from './Badge.astro';

interface Props {
  imobiliaria: Imobiliaria;
}

const { imobiliaria } = Astro.props;
---

<article class="group card-hover overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm">
  <a href={`/imobiliarias/${imobiliaria.slug}`} class="block">
    <div class="relative aspect-[16/9] overflow-hidden bg-stone-100">
      <img
        src={imobiliaria.capa}
        alt={`Fachada ${imobiliaria.nome}`}
        class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
        loading="lazy"
      />
      {imobiliaria.destaque && (
        <span class="absolute left-3 top-3 rounded-full bg-amber-400 px-2.5 py-1 text-xs font-bold uppercase tracking-wide text-amber-950">
          Destaque
        </span>
      )}
    </div>

    <div class="p-5">
      <div class="flex items-start gap-3">
        <img
          src={imobiliaria.logo}
          alt={imobiliaria.nome}
          class="h-12 w-12 shrink-0 rounded-xl border border-stone-100 bg-white object-cover"
          loading="lazy"
        />
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-2">
            <h3 class="truncate font-semibold text-stone-900 group-hover:text-brand-700 transition">
              {imobiliaria.nome}
            </h3>
            {imobiliaria.verificada && <Badge label="Verificada" variant="verified" />}
          </div>
          <p class="mt-0.5 text-sm text-muted">
            {imobiliaria.endereco.bairro}, {imobiliaria.endereco.cidade} — {imobiliaria.endereco.estado}
          </p>
        </div>
      </div>

      <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-stone-600">{imobiliaria.slogan}</p>

      <div class="mt-4 flex flex-wrap gap-1.5">
        {imobiliaria.especialidades.slice(0, 3).map((esp) => (
          <Badge label={especialidadeLabels[esp]} variant="brand" />
        ))}
      </div>

      <div class="mt-4 flex items-center justify-between border-t border-stone-100 pt-4">
        <div class="flex items-center gap-2">
          <StarRating rating={imobiliaria.avaliacao} />
          <span class="text-sm font-medium text-stone-700">{imobiliaria.avaliacao.toFixed(1)}</span>
          <span class="text-sm text-muted">({imobiliaria.totalAvaliacoes})</span>
        </div>
        <span class="text-xs text-muted">{imobiliaria.corretoresCount} corretores</span>
      </div>
    </div>
  </a>
</article>

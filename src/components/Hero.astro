---
import type { CidadeIndexEntry } from '../lib/cidades';

interface Props {
  topCidades: CidadeIndexEntry[];
  totalImobiliarias: number;
}

const { topCidades, totalImobiliarias } = Astro.props;
---

<section class="gradient-hero relative overflow-hidden px-4 pb-20 pt-16 sm:px-6 sm:pb-28 sm:pt-24 lg:px-8">
  <div class="absolute inset-0 opacity-10">
    <div class="absolute -left-20 top-20 h-72 w-72 rounded-full bg-brand-300 blur-3xl"></div>
    <div class="absolute -right-20 bottom-10 h-96 w-96 rounded-full bg-teal-300 blur-3xl"></div>
  </div>

  <div class="relative mx-auto max-w-4xl text-center">
    <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-sm font-medium text-brand-100 backdrop-blur-sm">
      <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
      {totalImobiliarias.toLocaleString('pt-BR')}+ imobiliárias cadastradas
    </span>

    <h1 class="font-display mt-6 text-balance text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">
      Encontre a imobiliária ou corretor ideal
    </h1>

    <p class="mx-auto mt-5 max-w-2xl text-balance text-lg leading-relaxed text-brand-100/90 sm:text-xl">
      O Guia Morada conecta você aos melhores profissionais do mercado imobiliário. Busque por cidade ou nome.
    </p>

    <form
      action="/imobiliarias/cidades"
      method="get"
      class="mx-auto mt-10 max-w-2xl rounded-2xl bg-white p-2 shadow-2xl shadow-brand-950/30 sm:flex sm:items-center sm:gap-2"
    >
      <div class="flex flex-1 items-center gap-3 px-4 py-3">
        <svg class="h-5 w-5 shrink-0 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          type="search"
          name="q"
          placeholder="Buscar cidade..."
          class="w-full bg-transparent text-stone-900 placeholder:text-stone-400 focus:outline-none"
        />
      </div>
      <button
        type="submit"
        class="mx-2 mb-2 rounded-xl bg-brand-600 px-6 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700 sm:mb-0"
      >
        Buscar
      </button>
    </form>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3 text-sm text-brand-100/80">
      <span>Populares:</span>
      {topCidades.slice(0, 4).map((city) => (
        <a
          href={`/${city.slug}`}
          class="rounded-full border border-white/20 px-3 py-1 transition hover:bg-white/10 hover:text-white"
        >
          {city.cidade}
        </a>
      ))}
    </div>
  </div>
</section>

---
import type { CidadeData } from '../lib/cidades';
import { getPrepositionLabel, paginateImobiliarias, IMOBILIARIAS_POR_PAGINA } from '../lib/cidades';
import CardImobiliariaCadastro from './CardImobiliariaCadastro.astro';
import Pagination from './Pagination.astro';

interface Props {
  data: CidadeData;
  page: number;
}

const { data, page } = Astro.props;
const imobiliarias = paginateImobiliarias(data.imobiliarias, page, IMOBILIARIAS_POR_PAGINA);
const prepLabel = getPrepositionLabel(data.prep, data.cidade);
---

<div class="border-b border-stone-200 bg-white">
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <nav class="mb-4 text-sm text-muted">
      <a href="/" class="hover:text-brand-700">Início</a>
      <span class="mx-2">/</span>
      <a href="/imobiliarias/cidades" class="hover:text-brand-700">Cidades</a>
      <span class="mx-2">/</span>
      <span class="text-stone-700">{data.cidade}</span>
    </nav>

    <h1 class="font-display text-3xl font-bold text-stone-900 sm:text-4xl">
      Imobiliárias {prepLabel}
    </h1>
    <p class="mt-2 text-muted">
      {data.total.toLocaleString('pt-BR')} {data.total === 1 ? 'imobiliária cadastrada' : 'imobiliárias cadastradas'} · {data.estado}
      {page > 1 && ` · Página ${page} de ${data.totalPages}`}
    </p>
  </div>
</div>

<div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
  <div class="grid gap-4">
    {imobiliarias.map((imob) => (
      <CardImobiliariaCadastro imobiliaria={imob} />
    ))}
  </div>

  <Pagination
    basePath={`/${data.slug}`}
    currentPage={page}
    totalPages={data.totalPages}
  />
</div>

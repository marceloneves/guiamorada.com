---
import { loadCidadesIndex } from '../lib/load-cidade';
import { loadConstrutorasIndex } from '../lib/load-construtoras';
import { corretores } from '../data/corretores';

const cidades = loadCidadesIndex();
const construtoras = loadConstrutorasIndex();
const totalImobiliarias = cidades.reduce((s, c) => s + c.total, 0);
const totalConstrutoras = construtoras.reduce((s, c) => s + c.total, 0);

const stats = [
  { value: totalImobiliarias, label: 'Imobiliárias', suffix: '' },
  { value: totalConstrutoras, label: 'Construtoras e incorporadoras', suffix: '' },
  { value: corretores.length, label: 'Corretores', suffix: '+' },
  { value: cidades.length, label: 'Cidades', suffix: '' },
];
---

<section class="border-y border-stone-200 bg-white">
  <div class="mx-auto grid max-w-7xl grid-cols-2 gap-6 px-4 py-10 sm:px-6 md:grid-cols-4 lg:px-8">
    {stats.map((stat) => (
      <div class="text-center">
        <p class="font-display text-3xl font-bold text-brand-700 sm:text-4xl">
          {stat.value.toLocaleString('pt-BR')}{stat.suffix}
        </p>
        <p class="mt-1 text-sm font-medium text-muted">{stat.label}</p>
      </div>
    ))}
  </div>
</section>
